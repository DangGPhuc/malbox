# ==============================================================================
# malbox-ai — Environment Configuration Template
# ==============================================================================

# Application Core
MALBOX_ENV=development
MALBOX_DEBUG=true
MALBOX_SECRET_KEY=dev-secret-key-change-in-production-min32chars
MALBOX_HOST=127.0.0.1
MALBOX_PORT=8000
MALBOX_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Quarantine
MALBOX_DATA_DIR=./data
MALBOX_QUARANTINE_DIR=./data/quarantine
MALBOX_ARTIFACTS_DIR=./data/artifacts
MALBOX_DATABASE_URL=sqlite:///./data/malbox.db

# Limits & Safety Gates
MALBOX_MAX_UPLOAD_SIZE_BYTES=33554432  # 32MB max
MALBOX_WORKER_CONCURRENCY=1
MALBOX_LIVE_MODE_ENABLED=false
MALBOX_REQUIRE_EXPLICIT_APPROVAL=true

# AI Orchestration & Intelligence
MALBOX_AI_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
MALBOX_AI_MODEL=gpt-4o-mini
MALBOX_AI_API_KEY=
MALBOX_AI_MAX_TOKENS=2048
MALBOX_AI_TEMPERATURE=0.1

# Sandbox Backends
MALBOX_DEFAULT_SANDBOX_BACKEND=replay  # Options: replay, cape
MALBOX_CAPE_API_URL=http://127.0.0.1:8000
MALBOX_CAPE_API_TOKEN=
MALBOX_CAPE_TIMEOUT_SECONDS=300
MALBOX_CAPE_POLL_INTERVAL_SECONDS=5
