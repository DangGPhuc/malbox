# ==============================================================================
# malbox-ai — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the project root or backend directory to customize settings.
# Environment variables prefixed with MALBOX_ will override values defined in .env.

# ------------------------------------------------------------------------------
# 1. Application Core & Host Binding
# ------------------------------------------------------------------------------
MALBOX_ENV=development
MALBOX_DEBUG=true
MALBOX_SECRET_KEY=dev-secret-key-change-in-production-min32chars

# For security and VM evaluation, bind exclusively to localhost (127.0.0.1)
MALBOX_HOST=127.0.0.1
MALBOX_PORT=8000
MALBOX_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 2. Storage, Quarantine & Database
# ------------------------------------------------------------------------------
MALBOX_DATA_DIR=./data
MALBOX_QUARANTINE_DIR=./data/quarantine
MALBOX_ARTIFACTS_DIR=./data/artifacts
# SQLite DB URL dynamically defaults to sqlite:///./data/malbox.db if left blank
MALBOX_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Execution Safety Gates & Operator Authorization
# ------------------------------------------------------------------------------
MALBOX_MAX_UPLOAD_SIZE_BYTES=33554432  # 32 MB max upload limit
MALBOX_WORKER_CONCURRENCY=1            # Bounded single-task pipeline execution

# Live Malware Detonation Safety Gate (Keep FALSE by default)
MALBOX_LIVE_MODE_ENABLED=false
MALBOX_REQUIRE_EXPLICIT_APPROVAL=true

# Operator Security Token Boundary:
# When MALBOX_LIVE_MODE_ENABLED=false, leave empty to enforce fail-closed security.
# When MALBOX_LIVE_MODE_ENABLED=true in production/isolated lab, you MUST configure
# a strong random secret token here (e.g. generated via `openssl rand -hex 32`).
# Live detonation and live cancellation requests require this token in the X-Operator-Token header.
MALBOX_OPERATOR_TOKEN=

# ------------------------------------------------------------------------------
# 4. AI Orchestration & Behavioral Intelligence
# ------------------------------------------------------------------------------
MALBOX_AI_PROVIDER=mock                # Options: mock, real, openai, ollama
MALBOX_AI_MODEL=gpt-4o-mini
MALBOX_AI_API_KEY=
MALBOX_AI_BASE_URL=https://api.openai.com/v1
MALBOX_AI_MAX_TOKENS=2048
MALBOX_AI_TEMPERATURE=0.1
MALBOX_AI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Sandbox Execution Backends
# ------------------------------------------------------------------------------
MALBOX_DEFAULT_SANDBOX_BACKEND=replay  # Options: replay, cape

# CAPE Sandbox Backend Configuration
# Default port is 8008 to prevent port collisions with the FastAPI backend on 8000.
MALBOX_CAPE_API_URL=http://127.0.0.1:8008
MALBOX_CAPE_API_TOKEN=
MALBOX_CAPE_TIMEOUT_SECONDS=300
MALBOX_CAPE_POLL_INTERVAL_SECONDS=5
